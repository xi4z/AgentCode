# AgentCode 本地运行配置模板（复制为 .env 后填入真实值；.env 已被 .gitignore 忽略）
# 用法：scripts/with-env.sh mvn spring-boot:run
#
# 说明：application.yml 里所有 ${VAR:default} 都通过进程环境变量注入，
# Spring Boot 本身不会自动读取 .env 文件，必须用 scripts/with-env.sh 或自行 export。

# ---------- Elasticsearch（长期记忆索引 agent_memory 所在集群） ----------
# 本地 es 容器以 xpack.security.enabled=false 启动，无需账号密码
ES_URIS=http://localhost:9200
ES_CONNECTION_TIMEOUT=5s
ES_SOCKET_TIMEOUT=30s

# ---------- 模型 provider ----------
# chat: openai / dashscope / anthropic / ollama
# embedding 必须显式指定：同时引入 openai + dashscope starter 时会有多个 EmbeddingModel bean
AI_MODEL_PROVIDER=dashscope
AI_EMBEDDING_MODEL_PROVIDER=dashscope

# ---------- DashScope（chat + 向量模型） ----------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# 注意：这里【不能】带 /api/v1。
# DashScopeApi 的 embeddingsPath 常量已含 "/api/v1/services/embeddings/..."，
# base-url 再带一次会拼成 /api/v1/api/v1/... 导致 404。
# 公共端点：https://dashscope.aliyuncs.com
# 专属 MaaS 实例：https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_CHAT_MODEL=qwen-max
# 记忆抽取 Agent 走同一个 ChatModel，温度调低更利于稳定 JSON 输出
DASHSCOPE_TEMPERATURE=0.3
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
# 【必须】与向量模型真实输出维度一致，ensureIndex() 用它建 dense_vector mapping；
# 探测失败时代码回退 1536，与 1024 维模型不匹配会让 kNN 直接报错。
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

# ---------- OpenAI（仅当 provider 切回 openai 时需要） ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---------- MySQL（audit_log 等表） ----------
# 值里有 & ，source 时必须加引号，否则 bash 会把 & 当成后台运行符
DB_URL="jdbc:mysql://localhost:3306/agentcode?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
DB_USERNAME=root
DB_PASSWORD=change-me

# ---------- Redis（graph checkpoint） ----------
# 本地 redis 容器带 --requirepass，密码留空会在 redissonClient 处抛
# RedisAuthRequiredException: NOAUTH，导致整个上下文启动失败
REDIS_CHECKPOINT_ADDRESS=redis://127.0.0.1:6379
REDIS_CHECKPOINT_PASSWORD=change-me

# ---------- 日志 ----------
LOG_LEVEL=INFO
AGENT_LOG_LEVEL=DEBUG
LOG_FILE=logs/agentcode.log
